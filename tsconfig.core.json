  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".test-dist"
  },
  "include": [
    "assets/game/scripts/core/**/*.ts",
    "assets/game/configs/**/*.ts",
    "assets/game/scripts/services/SaveService.ts",
    "assets/game/tests/**/*.ts"
  ]
}
